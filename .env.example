# IP of this Raspberry Pi (same subnet as Bose)
RELAY_IP=192.168.0.50

# Real Bose Soundbar IP
BOSE_IP=192.168.0.100

# One allowed client CIDR per port group (use a subnet for multiple clients)
# Music Assistant (Chromecast)
CAST_ALLOW=192.168.4.10/32

# Home Assistant (Bose API)
API_ALLOW=192.168.4.10/32

# Virtual Chromecast identity
CAST_NAME="Bose 900 Relay"
CAST_ID="REPLACE_WITH_STABLE_UUID"
