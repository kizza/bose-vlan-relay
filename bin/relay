#!/usr/bin/env bash
set -euo pipefail

invalid_config() {
  echo "Invalid configuration: $*" >&2
  exit 2
}

# Required configuration (injected by systemd)
for name in RELAY_IP BOSE_IP CAST_ALLOW API_ALLOW CAST_NAME CAST_ID; do
  [[ -n ${!name:-} ]] || invalid_config "set $name"
done

valid_ip() {
  local ip="$1" octet
  local -a octets

  [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r -a octets <<< "$ip"
  for octet in "${octets[@]}"; do
    (( 10#$octet <= 255 )) || return 1
  done
}

valid_cidr() {
  local cidr="$1" prefix
  [[ $cidr =~ ^(.+)/([0-9]{1,2})$ ]] || return 1
  prefix="${BASH_REMATCH[2]}"
  valid_ip "${BASH_REMATCH[1]}" && (( 10#$prefix >= 1 && 10#$prefix <= 32 ))
}

valid_ip "$RELAY_IP" || invalid_config "RELAY_IP must be an IPv4 address"
valid_ip "$BOSE_IP" || invalid_config "BOSE_IP must be an IPv4 address"
valid_cidr "$CAST_ALLOW" || invalid_config "CAST_ALLOW must be one IPv4 CIDR (prefix 1-32)"
valid_cidr "$API_ALLOW" || invalid_config "API_ALLOW must be one IPv4 CIDR (prefix 1-32)"
[[ $CAST_ID =~ ^([[:xdigit:]]{32}|[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12})$ ]] || invalid_config "CAST_ID must be a stable UUID or 32 hexadecimal digits"

# Preserve the Bose's TXT records, including fields we do not yet understand.
# Only the virtual receiver's identity and displayed name are changed.
txt_file="${CAST_TXT_FILE:-/etc/bose-vlan-relay.txt}"
[[ -r $txt_file ]] || invalid_config "cannot read Cast TXT file: $txt_file"
txt_entries=()
seen_keys='|'
has_md=false has_ca=false has_ve=false
while IFS= read -r entry || [[ -n $entry ]]; do
  [[ -z $entry || $entry == \#* ]] && continue
  [[ $entry =~ ^([a-zA-Z0-9_-]+)=(.*)$ ]] || invalid_config "invalid TXT record: $entry"
  key="${BASH_REMATCH[1]}"
  value="${BASH_REMATCH[2]}"
  [[ $key == id || $key == fn ]] && continue
  [[ $seen_keys != *"|$key|"* ]] || invalid_config "duplicate TXT key: $key"
  seen_keys+="$key|"
  [[ $value != REPLACE_WITH_* ]] || invalid_config "set $key in $txt_file"
  (( ${#entry} <= 255 )) || invalid_config "TXT record too long: $key"
  case "$key" in
    md) has_md=true ;;
    ca) [[ $value =~ ^[0-9]+$ ]] || invalid_config "ca must be numeric"; has_ca=true ;;
    ve) [[ $value =~ ^[0-9]+$ ]] || invalid_config "ve must be numeric"; has_ve=true ;;
  esac
  txt_entries+=("$entry")
done < "$txt_file"
[[ $has_md == true && $has_ca == true && $has_ve == true ]] || invalid_config "Cast TXT needs md, ca and ve"

if [[ ${1:-} == --check ]]; then
  echo "Configuration valid. This does not check connectivity or playback."
  printf 'Advertised TXT: %s\n' "${txt_entries[@]}" "id=$CAST_ID" "fn=$CAST_NAME"
  exit 0
fi
(( $# == 0 )) || invalid_config "unknown argument: $1"

pids=()

cleanup() {
  trap - EXIT INT TERM

  if (( ${#pids[@]} > 0 )); then
    kill "${pids[@]}" 2>/dev/null || true
    wait "${pids[@]}" 2>/dev/null || true
  fi
}

trap cleanup EXIT
trap 'exit 0' INT TERM

# Start a restricted, bidirectional TCP relay
relay_port() {
  local port="$1"
  local allowed="$2"

  socat -d -d \
    "TCP4-LISTEN:${port},bind=${RELAY_IP},reuseaddr,fork,range=${allowed}" \
    "TCP4:${BOSE_IP}:${port}" &

  pids+=("$!")
}

# Bose proprietary API
relay_port 8082 "$API_ALLOW"

# Chromecast HTTP, CastV2, and HTTPS setup/device information
relay_port 8008 "$CAST_ALLOW"
relay_port 8009 "$CAST_ALLOW"
relay_port 8443 "$CAST_ALLOW"

# Advertise the proxy as a Chromecast receiver.
# Avahi uses this host's mDNS hostname/address.
avahi-publish-service --no-fail \
  "$CAST_NAME" _googlecast._tcp 8009 \
  "${txt_entries[@]}" \
  "id=$CAST_ID" \
  "fn=$CAST_NAME" &

pids+=("$!")

# If any component exits, stop the rest.
# systemd will restart the service.
wait -n "${pids[@]}"

echo "A relay or publisher stopped; restarting." >&2
exit 1
